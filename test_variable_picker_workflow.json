{
  "id": "test_variable_picker_workflow",
  "name": "Test Variable Picker Workflow",
  "description": "Workflow to test the variable picker functionality",
  "nodes": [
    {
      "id": "manual_trigger_1",
      "type": "Manual Trigger",
      "name": "Start Workflow",
      "position": { "x": 100, "y": 100 },
      "config": {
        "triggerData": {
          "userId": "123",
          "userName": "John Doe"
        }
      }
    },
    {
      "id": "http_request_1",
      "type": "HTTP Request",
      "name": "Fetch User Data",
      "position": { "x": 300, "y": 100 },
      "config": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/users/1",
        "timeout": 10000
      }
    },
    {
      "id": "string_manipulation_1",
      "type": "String Manipulation",
      "name": "Format Name",
      "position": { "x": 500, "y": 100 },
      "config": {
        "operation": "toUpperCase",
        "input": "{{http_request_1.data.name}}"
      }
    },
    {
      "id": "logger_1",
      "type": "Logger",
      "name": "Log Results",
      "position": { "x": 700, "y": 100 },
      "config": {
        "level": "info",
        "message": "User: {{string_manipulation_1.result}}, Email: {{http_request_1.data.email}}"
      }
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "sourceNodeId": "manual_trigger_1",
      "targetNodeId": "http_request_1"
    },
    {
      "id": "conn_2",
      "sourceNodeId": "http_request_1",
      "targetNodeId": "string_manipulation_1"
    },
    {
      "id": "conn_3",
      "sourceNodeId": "http_request_1",
      "targetNodeId": "logger_1"
    },
    {
      "id": "conn_4",
      "sourceNodeId": "string_manipulation_1",
      "targetNodeId": "logger_1"
    }
  ]
}