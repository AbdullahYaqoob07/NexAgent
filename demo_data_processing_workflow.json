{
  "id": "demo_data_processing_workflow",
  "name": "Demo: Data Processing",
  "description": "Fetches data from API, processes it, and formats output",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "Manual Trigger",
      "name": "Start",
      "position": { "x": 100, "y": 150 },
      "config": {
        "triggerData": {}
      }
    },
    {
      "id": "http_1",
      "type": "HTTP Request",
      "name": "Fetch User Data",
      "position": { "x": 300, "y": 150 },
      "config": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/users/1",
        "timeout": 10000
      }
    },
    {
      "id": "string_1",
      "type": "String Manipulation",
      "name": "Format Name",
      "position": { "x": 500, "y": 150 },
      "config": {
        "operation": "toUpperCase",
        "input": "{{$node.http_1.data.name}}"
      }
    },
    {
      "id": "date_1",
      "type": "Date Formatter",
      "name": "Current Date",
      "position": { "x": 500, "y": 250 },
      "config": {
        "format": "YYYY-MM-DD HH:mm:ss",
        "inputDate": "now"
      }
    },
    {
      "id": "logger_1",
      "type": "Logger",
      "name": "Log Processed Data",
      "position": { "x": 700, "y": 200 },
      "config": {
        "level": "info",
        "message": "User: {{$node.string_1.output}} | Email: {{$node.http_1.data.email}} | Processed at: {{$node.date_1.formattedDate}}"
      }
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "sourceNodeId": "trigger_1",
      "targetNodeId": "http_1"
    },
    {
      "id": "conn_2",
      "sourceNodeId": "http_1",
      "targetNodeId": "string_1"
    },
    {
      "id": "conn_3",
      "sourceNodeId": "http_1",
      "targetNodeId": "date_1"
    },
    {
      "id": "conn_4",
      "sourceNodeId": "string_1",
      "targetNodeId": "logger_1"
    },
    {
      "id": "conn_5",
      "sourceNodeId": "date_1",
      "targetNodeId": "logger_1"
    }
  ]
}
