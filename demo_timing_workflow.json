{
  "id": "demo_timing_workflow",
  "name": "Demo: Timing and Delays",
  "description": "Tests timing nodes and delays",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "Manual Trigger",
      "name": "Start",
      "position": { "x": 100, "y": 100 },
      "config": {}
    },
    {
      "id": "timer_1",
      "type": "Timer",
      "name": "Start Timer",
      "position": { "x": 300, "y": 100 },
      "config": {
        "action": "start"
      }
    },
    {
      "id": "http_1",
      "type": "HTTP Request",
      "name": "Quick API Call",
      "position": { "x": 500, "y": 100 },
      "config": {
        "method": "GET",
        "url": "https://httpbin.org/delay/1",
        "timeout": 10000
      }
    },
    {
      "id": "timer_2",
      "type": "Timer",
      "name": "Stop Timer",
      "position": { "x": 700, "y": 100 },
      "config": {
        "action": "stop",
        "timerName": "{{$node.timer_1.timerId}}"
      }
    },
    {
      "id": "logger_1",
      "type": "Logger",
      "name": "Log Timing",
      "position": { "x": 900, "y": 100 },
      "config": {
        "level": "info",
        "message": "API call took {{$node.timer_2.elapsedMs}}ms to complete"
      }
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "sourceNodeId": "trigger_1",
      "targetNodeId": "timer_1"
    },
    {
      "id": "conn_2",
      "sourceNodeId": "timer_1",
      "targetNodeId": "http_1"
    },
    {
      "id": "conn_3",
      "sourceNodeId": "http_1",
      "targetNodeId": "timer_2"
    },
    {
      "id": "conn_4",
      "sourceNodeId": "timer_2",
      "targetNodeId": "logger_1"
    }
  ]
}
