{
  "id": "test_simple_workflow_001",
  "name": "Simple Test Workflow",
  "description": "Basic workflow to test: Manual Trigger → HTTP Request → Logger",
  "nodes": [
    {
      "id": "trigger_1",
      "type": "Manual Trigger",
      "name": "Manual Start",
      "position": { "x": 100, "y": 100 },
      "config": {
        "triggerData": {
          "message": "Starting simple test workflow",
          "timestamp": "2024-01-01T00:00:00Z"
        }
      }
    },
    {
      "id": "http_1",
      "type": "HTTP Request",
      "name": "Fetch API Data",
      "position": { "x": 300, "y": 100 },
      "config": {
        "method": "GET",
        "url": "https://httpbin.org/get",
        "headers": {
          "Content-Type": "application/json"
        },
        "timeout": 10000
      }
    },
    {
      "id": "logger_1",
      "type": "Logger",
      "name": "Log Result",
      "position": { "x": 500, "y": 100 },
      "config": {
        "level": "info",
        "message": "Received data: {{$node.http_1.title}}"
      }
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "sourceNodeId": "trigger_1",
      "targetNodeId": "http_1",
      "sourceHandle": "output",
      "targetHandle": "input"
    },
    {
      "id": "conn_2",
      "sourceNodeId": "http_1",
      "targetNodeId": "logger_1",
      "sourceHandle": "output",
      "targetHandle": "input"
    }
  ],
  "config": {
    "version": "1.0",
    "createdAt": "2024-01-01T00:00:00Z"
  }
}
