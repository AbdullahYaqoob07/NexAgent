{
  "id": "test-data-transformation-workflow",
  "name": "Data Transformation Test Workflow",
  "description": "Tests Logger, Variable Setter, String Manipulation, Number Formatter, and Date Formatter nodes",
  "nodes": [
    {
      "id": "manual_trigger",
      "type": "On Clicking Execute",
      "name": "Start Workflow",
      "category": "Triggers",
      "position": {"x": 100, "y": 300},
      "config": {},
      "inputs": [],
      "outputs": [{"id": "output", "name": "Output", "type": "any", "required": true}],
      "enabled": true
    },
    {
      "id": "sample_data",
      "type": "HTTP Request",
      "name": "Sample Data Source",
      "category": "Actions",
      "position": {"x": 300, "y": 300},
      "config": {
        "url": "https://jsonplaceholder.typicode.com/users/1",
        "method": "GET"
      },
      "inputs": [{"id": "input", "name": "Input", "type": "any", "required": false}],
      "outputs": [{"id": "output", "name": "Output", "type": "any", "required": true}],
      "enabled": true
    },
    {
      "id": "log_raw_data",
      "type": "Logger",
      "name": "Log Raw Data",
      "category": "Actions",
      "position": {"x": 500, "y": 200},
      "config": {
        "logLevel": "info",
        "message": "Raw data from API:"
      },
      "inputs": [{"id": "input", "name": "Input", "type": "any", "required": false}],
      "outputs": [{"id": "output", "name": "Output", "type": "any", "required": true}],
      "enabled": true
    },
    {
      "id": "string_transform",
      "type": "String Manipulation",
      "name": "Format Username",
      "category": "Data",
      "position": {"x": 500, "y": 300},
      "config": {
        "inputField": "name",
        "operation": "uppercase"
      },
      "inputs": [{"id": "input", "name": "Input", "type": "any", "required": true}],
      "outputs": [
        {"id": "output", "name": "Output", "type": "any", "required": true}
      ],
      "enabled": true
    },
    {
      "id": "number_format",
      "type": "Number Formatter",
      "name": "Format ID as Code",
      "category": "Data",
      "position": {"x": 500, "y": 400},
      "config": {
        "inputField": "id",
        "decimalPlaces": 0,
        "prefix": "USR-",
        "thousandsSeparator": false
      },
      "inputs": [{"id": "input", "name": "Input", "type": "any", "required": true}],
      "outputs": [
        {"id": "output", "name": "Output", "type": "any", "required": true}
      ],
      "enabled": true
    },
    {
      "id": "set_variable",
      "type": "Variable Setter",
      "name": "Store Formatted Name",
      "category": "Actions",
      "position": {"x": 700, "y": 300},
      "config": {
        "variableName": "formattedUsername",
        "valueSource": "input"
      },
      "inputs": [{"id": "input", "name": "Input", "type": "any", "required": false}],
      "outputs": [{"id": "output", "name": "Output", "type": "any", "required": true}],
      "enabled": true
    },
    {
      "id": "log_final",
      "type": "Logger",
      "name": "Log Final Results",
      "category": "Actions",
      "position": {"x": 900, "y": 300},
      "config": {
        "logLevel": "info",
        "message": "Workflow completed successfully"
      },
      "inputs": [{"id": "input", "name": "Input", "type": "any", "required": false}],
      "outputs": [{"id": "output", "name": "Output", "type": "any", "required": true}],
      "enabled": true
    }
  ],
  "connections": [
    {
      "id": "conn_1",
      "sourceNodeId": "manual_trigger",
      "targetNodeId": "sample_data",
      "sourcePortId": "output",
      "targetPortId": "input",
      "enabled": true
    },
    {
      "id": "conn_2",
      "sourceNodeId": "sample_data",
      "targetNodeId": "log_raw_data",
      "sourcePortId": "output",
      "targetPortId": "input",
      "enabled": true
    },
    {
      "id": "conn_3",
      "sourceNodeId": "sample_data",
      "targetNodeId": "string_transform",
      "sourcePortId": "output",
      "targetPortId": "input",
      "enabled": true
    },
    {
      "id": "conn_4",
      "sourceNodeId": "sample_data",
      "targetNodeId": "number_format",
      "sourcePortId": "output",
      "targetPortId": "input",
      "enabled": true
    },
    {
      "id": "conn_5",
      "sourceNodeId": "string_transform",
      "targetNodeId": "set_variable",
      "sourcePortId": "output",
      "targetPortId": "input",
      "enabled": true
    },
    {
      "id": "conn_6",
      "sourceNodeId": "set_variable",
      "targetNodeId": "log_final",
      "sourcePortId": "output",
      "targetPortId": "input",
      "enabled": true
    }
  ]
}